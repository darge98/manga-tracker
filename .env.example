# Copy to .env. Compose uses PostgreSQL; native scripts/dev.sh keeps JSON.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
POSTGRES_DB=manga_track
POSTGRES_USER=manga_track
# Local development only. Replace with an URL-safe random password for your setup.
POSTGRES_PASSWORD=local-development-only-change-this
# Optional Docker override (defaults derive from APP_PORT):
# DOCKER_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Native development defaults. Compose overrides HOST and PORT internally.
PORT=8080
HOST=127.0.0.1
DATA_FILE=data/manga-track.json
ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
COOKIE_SECURE=false
