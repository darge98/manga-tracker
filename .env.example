# Copy to .env, then: docker compose up --build -d
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
POSTGRES_DB=manga_track
POSTGRES_USER=manga_track
# Local development only. Replace with an URL-safe random password (openssl rand -hex 24).
POSTGRES_PASSWORD=local-development-only-change-this
# Client ID of a MyAnimeList API app (https://myanimelist.net/apiconfig): enables the catalog.
MAL_CLIENT_ID=
# Set to true when the UI is served over HTTPS.
COOKIE_SECURE=false
# Optional: extra cross-origin callers (same-origin requests are always allowed).
# DOCKER_ALLOWED_ORIGINS=https://other-app.example.com
